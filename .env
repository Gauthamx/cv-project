# CampusVision Configuration
# MongoDB connection string (leave default or point to MongoDB Atlas cluster)
MONGO_URI=mongodb://127.0.0.1:27017/campusvision

# Server Port
PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:5000

# Set DEMO_MODE=true for automatic live simulated data without physical cameras
# Set DEMO_MODE=false when using only real YOLO camera detection feed
DEMO_MODE=true

# AI / Vision settings
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.5
